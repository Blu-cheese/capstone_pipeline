# Secrets — never commit. The pipeline reads .env via utils/env.py.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# Corpora and derived data. AMI is 22MB+ of CC BY 4.0 XML; re-downloadable,
# and the labelled/feature caches are reproducible from it.
data/raw/
data/labeled/
data/features/
data/cache/

# Model / run artefacts
runs/
output/*/
*.npz
*.pt

# macOS / editors
.DS_Store
.vscode/
.idea/
*.swp

# Phase 7 per-run predictions are results, not caches (PHASE6_7_SPEC §4.1)
!results/*/predictions.npz
